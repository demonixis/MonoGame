<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <DefineConstants>OPENGL;NATIVE;DESKTOP</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('MacOS'))">$(DefineConstants);MACOS</DefineConstants>
    <Platforms>AnyCPU;ARM64;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnitLite" Version="3.13.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*" />
    <Compile Remove="**/bin/**/*.cs" />
    <Compile Remove="Framework/WindowsDX/**" />
    <Compile Remove="obj/**/*" />
    <Compile Remove="**/obj/**/*.cs" />
    <Compile Remove="Properties/**/*" />
    <Compile Remove="Interactive/**/*" />
    <Compile Remove="Runner/iOS/**/*" />
    <Compile Remove="AndroidVulkanPackageSmoke/**/*" />
    <Compile Remove="MobileGlesSmoke/**/*" />
    <Compile Remove="AppleMetalSmoke/**/*" />
    <Compile Remove="AppleMetalSmoke.iOS/**/*" />
    <Compile Remove="AppleMetalPackageSmoke/**/*" />
    <Compile Remove="Framework/SDL/**/*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../MonoGame.Framework/Platform/Graphics/Effect/Resources/*.fx*">
      <Link>Assets/Effects/Stock/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../Artifacts/native/opengl-effects/NativeOpenGLMrt.mgfxo"
             Condition="Exists('../Artifacts/native/opengl-effects/NativeOpenGLMrt.mgfxo')"
             Link="NativeOpenGLMrt.mgfxo"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Artifacts/native/opengl-effects/NativeOpenGLCube.mgfxo"
             Condition="Exists('../Artifacts/native/opengl-effects/NativeOpenGLCube.mgfxo')"
             Link="NativeOpenGLCube.mgfxo"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireNativeOpenGLValidationEffect" BeforeTargets="Build">
    <Error Condition="!Exists('../Artifacts/native/opengl-effects/NativeOpenGLMrt.mgfxo')"
           Text="NativeOpenGLMrt.mgfxo is missing. Run scripts/native-opengl/build-stock-effects.sh before building the native OpenGL validation tests." />
    <Error Condition="!Exists('../Artifacts/native/opengl-effects/NativeOpenGLCube.mgfxo')"
           Text="NativeOpenGLCube.mgfxo is missing. Run scripts/native-opengl/build-stock-effects.sh before building the native OpenGL validation tests." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Remove="Framework/WindowsDX/**" />
    <EmbeddedResource Remove="obj/**/*" />
    <EmbeddedResource Remove="**/obj/**/*" />
    <None Remove="Framework/WindowsDX/**" />
    <None Remove="obj/**/*" />
    <None Remove="**/obj/**/*" />
  </ItemGroup>

  <PropertyGroup>
    <_LowerCasePlatform>$([MSBuild]::ValueOrDefault('$(Platform)', '').ToLowerInvariant())</_LowerCasePlatform>
    <_OSArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_OSArchitecture>
    <NativePlatform Condition="'$(_LowerCasePlatform)' == 'arm64' or '$(_LowerCasePlatform)' == 'x64'">$(_LowerCasePlatform)</NativePlatform>
    <NativePlatform Condition="'$(NativePlatform)' == '' And '$(_OSArchitecture)' != ''">$(_OSArchitecture)</NativePlatform>
    <NativePlatform Condition="'$(NativePlatform)' == ''">x64</NativePlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MonoGame.Framework/MonoGame.Framework.Native.csproj" />
    <NativeLib Include="../Artifacts/native/mgruntime/desktopgl/windows/$(NativePlatform)/$(Configuration)/mgruntime.dll" Condition="Exists('../Artifacts/native/mgruntime/desktopgl/windows/$(NativePlatform)/$(Configuration)/mgruntime.dll')" />
    <NativeLib Include="../Artifacts/native/mgruntime/desktopgl/linux/$(NativePlatform)/$(Configuration)/libmgruntime.so" Condition="Exists('../Artifacts/native/mgruntime/desktopgl/linux/$(NativePlatform)/$(Configuration)/libmgruntime.so')" />
    <NativeLib Include="../Artifacts/native/mgruntime/desktopgl/macosx/$(Configuration)/libmgruntime.dylib" Condition="Exists('../Artifacts/native/mgruntime/desktopgl/macosx/$(Configuration)/libmgruntime.dylib')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="@(NativeLib)" Visible="false" CopyToOutputDirectory="PreserveNewest" />
    <UpToDateCheckBuilt Include="@(NativeLib->'$(OutputPath)%(Filename)%(Extension)')"><Original>%(Identity)</Original></UpToDateCheckBuilt>
  </ItemGroup>

</Project>
